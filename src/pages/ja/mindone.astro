---
import Fresh from '../../layouts/Fresh.astro';
import Liability from '../../components/Liability.astro';
import {
  built,
  copy,
  development,
  device,
  features,
  keywords,
  overview,
  repos,
  updated,
} from '../../data/mindone.ts';

const updatedOn = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(updated);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: `${device.name} — Android 17`,
  headline: device.ja.tagline,
  description: device.ja.blurb,
  url: new URL('/ja/mindone', Astro.site).href,
  codeRepository: repos.map((repo) => repo.href),
  programmingLanguage: ['C', 'C++', 'Rust'],
  runtimePlatform: 'Android',
  inLanguage: 'ja',
  dateModified: updated.toISOString().slice(0, 10),
  keywords: keywords.join(', '),
  author: { '@type': 'Person', name: 'Ilia Snezhkov', url: 'https://nonbiri.dev/about' },
};
---

<Fresh title="MindOne — カードサイズの端末に Android 17 を" description={device.ja.blurb} lang="ja" alternate="/mindone">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <div class="page">
    <section class="opener">
      <div class="opener__field"></div>

      <div class="opener__type">
        <p class="micro micro--accent">非公式の Android · iKKO MindOne</p>
        <h1 class="mag-1 mt-md">MindOne</h1>
        <p class="mag-3 mt-lg">{device.ja.tagline}</p>
        <p class="read mt-xl">{device.ja.summary}</p>
        <p class="micro mt-xl">
          <span>開発中 · 更新 </span>
          <time datetime={updated.toISOString()}>{updatedOn}</time>
        </p>
      </div>

      <div class="opener__aside">
        <p class="micro">いまの状況</p>
        <ul class="ship mt-lg">
          {overview.map((item) => (
            <li>
              <p class="ship__name">{item.ja.title}</p>
              <p class="note mt-sm">{item.ja.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <section class="statement statement--soft">
    <div class="page">
      <p class="micro">どんな仕事だったか</p>
      <p class="statement__t mt-lg">{device.ja.statementTitle}</p>
      <p class="note mt-xl">{device.ja.statement}</p>
    </div>
  </section>

  <div class="page">
    <section class="spread">
      <p class="micro">このプロジェクトでしていること</p>
      <div class="entries mt-2xl">
        {built.map((item, index) => (
          <article class="entry">
            <div class="entry__n">{String(index + 1).padStart(2, '0')}</div>
            <div class="entry__t">
              <h2 class="mag-3">{item.ja.name}</h2>
              <p class="micro mt-sm">{item.ja.scale}</p>
            </div>
            <p class="entry__b note">{item.ja.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="spread grid">
      <div class="col-c">
        <p class="micro">使える機能</p>
        <p class="read mt-lg">{copy.ja.works}</p>
      </div>
      <div class="col-d">
        <ul class="tags mt-lg">{features.map((item) => <li>{item.ja}</li>)}</ul>
      </div>
    </section>

    <section class="spread grid">
      <div class="col-c">
        <p class="micro">どんな端末？</p>
        <p class="read mt-lg">{device.ja.about}</p>
      </div>
      <div class="col-d">
        <dl class="spec mt-lg">
          {device.specs.map((spec) => (
            <div class="spec__row">
              <dt>{spec.ja.label}</dt>
              <dd>{spec.ja.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="spread">
      <p class="micro">これから取り組むこと</p>
      <div class="entries mt-2xl">
        {development.map((item, index) => (
          <article class="entry">
            <div class="entry__n">{String(index + 1).padStart(2, '0')}</div>
            <div class="entry__t"><h2 class="mag-3">{item.ja.name}</h2></div>
            <p class="entry__b note">{item.ja.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="spread grid">
      <div class="col-c">
        <p class="micro">自分の端末にも入れられる？</p>
        <p class="read mt-lg">{copy.ja.install}</p>
      </div>
      <div class="col-d">
        <p class="micro">開発者の方へ</p>
        <p class="note mt-lg">{copy.ja.source}</p>
        <ul class="ship mt-xl">
          {repos.map((repo) => (
            <li>
              <p class="ship__name"><a class="link" href={repo.href}>{repo.name}</a></p>
              <p class="note mt-md">{repo.ja.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Liability tight lang="ja" />
  </div>
</Fresh>
