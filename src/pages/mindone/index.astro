---
import Fresh from '../../layouts/Fresh.astro';
import Liability from '../../components/Liability.astro';
import {
  built,
  copy,
  development,
  device,
  features,
  keywords,
  overview,
  repos,
  updated,
} from '../../data/mindone.ts';

const updatedOn = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(updated);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: `${device.name} — Android 17`,
  headline: device.tagline,
  description: device.blurb,
  url: new URL('/mindone', Astro.site).href,
  codeRepository: repos.map((repo) => repo.href),
  programmingLanguage: ['C', 'C++', 'Rust'],
  runtimePlatform: 'Android',
  inLanguage: 'en',
  dateModified: updated.toISOString().slice(0, 10),
  keywords: keywords.join(', '),
  author: { '@type': 'Person', name: 'Ilia Snezhkov', url: 'https://nonbiri.dev/about' },
};
---

<Fresh title="MindOne — Android 17 for a card-sized phone" description={device.blurb} alternate="/ja/mindone">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <div class="page">
    <section class="opener">
      <div class="opener__field"></div>

      <div class="opener__type">
        <p class="micro micro--accent">Unofficial Android · iKKO MindOne</p>
        <h1 class="mag-1 mt-md">MindOne</h1>
        <p class="mag-3 mt-lg">{device.tagline}</p>
        <p class="read mt-xl">{device.summary}</p>
        <p class="micro mt-xl">
          <span>In development · updated </span>
          <time datetime={updated.toISOString()}>{updatedOn}</time>
        </p>
      </div>

      <div class="opener__aside">
        <p class="micro">Right now</p>
        <ul class="ship mt-lg">
          {overview.map((item) => (
            <li>
              <p class="ship__name">{item.title}</p>
              <p class="note mt-sm">{item.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <section class="statement statement--soft">
    <div class="page">
      <p class="micro">What the work was</p>
      <p class="statement__t mt-lg">{device.statementTitle}</p>
      <p class="note mt-xl">{device.statement}</p>
    </div>
  </section>

  <div class="page">
    <section class="spread">
      <p class="micro">What the project does</p>
      <div class="entries mt-2xl">
        {built.map((item, index) => (
          <article class="entry">
            <div class="entry__n">{String(index + 1).padStart(2, '0')}</div>
            <div class="entry__t">
              <h2 class="mag-3">{item.name}</h2>
              <p class="micro mt-sm">{item.scale}</p>
            </div>
            <p class="entry__b note">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="spread grid">
      <div class="col-c">
        <p class="micro">What works</p>
        <p class="read mt-lg">{copy.works}</p>
      </div>
      <div class="col-d">
        <ul class="tags mt-lg">{features.map((item) => <li>{item.en}</li>)}</ul>
      </div>
    </section>

    <section class="spread grid">
      <div class="col-c">
        <p class="micro">About the phone</p>
        <p class="read mt-lg">{device.about}</p>
      </div>
      <div class="col-d">
        <dl class="spec mt-lg">
          {device.specs.map((spec) => (
            <div class="spec__row">
              <dt>{spec.label}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="spread">
      <p class="micro">What’s next</p>
      <div class="entries mt-2xl">
        {development.map((item, index) => (
          <article class="entry">
            <div class="entry__n">{String(index + 1).padStart(2, '0')}</div>
            <div class="entry__t"><h2 class="mag-3">{item.name}</h2></div>
            <p class="entry__b note">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="spread grid">
      <div class="col-c">
        <p class="micro">Can I install it?</p>
        <p class="read mt-lg">{copy.install}</p>
      </div>
      <div class="col-d">
        <p class="micro">For developers</p>
        <p class="note mt-lg">{copy.source}</p>
        <ul class="ship mt-xl">
          {repos.map((repo) => (
            <li>
              <p class="ship__name"><a class="link" href={repo.href}>{repo.name}</a></p>
              <p class="note mt-md">{repo.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Liability tight />
  </div>
</Fresh>
